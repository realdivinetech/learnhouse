<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" fill="none">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a1a1a"/>
      <stop offset="50%" stop-color="#2d2d2d"/>
      <stop offset="100%" stop-color="#1a1a1a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ee6c4d"/>
      <stop offset="100%" stop-color="#d4563c"/>
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  <!-- Subtle pattern overlay -->
  <rect width="1200" height="630" fill="url(#accent)" opacity="0.03"/>
  <!-- Brand mark -->
  <rect x="100" y="215" width="120" height="120" rx="24" fill="url(#accent)"/>
  <text x="125" y="300" font-family="system-ui, -apple-system, sans-serif" font-size="54" font-weight="800" fill="#fff" letter-spacing="2">DB</text>
  <!-- Title -->
  <text x="260" y="290" font-family="system-ui, -apple-system, sans-serif" font-size="52" font-weight="700" fill="#fff" letter-spacing="-0.5">DigitalBridge</text>
  <text x="260" y="340" font-family="system-ui, -apple-system, sans-serif" font-size="22" font-weight="400" fill="rgba(255,255,255,0.6)" letter-spacing="4">EMPOWERING SCHOOLS WITH DIGITAL &amp; VOCATIONAL EDUCATION</text>
  <!-- Divider -->
  <rect x="260" y="365" width="80" height="3" rx="1.5" fill="#ee6c4d"/>
  <!-- Bottom bar -->
  <rect x="0" y="580" width="1200" height="50" fill="#ee6c4d" opacity="0.15"/>
  <text x="600" y="610" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="500" fill="rgba(255,255,255,0.4)" text-anchor="middle" letter-spacing="6">LEARN.DIGITALBRIDGE.NG</text>
</svg>
